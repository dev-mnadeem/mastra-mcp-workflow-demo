# Read by `docker compose` from a .env file next to docker-compose.yml.
# Every value is optional; the stack runs on the offline stub with none set.

# stub (default, no network, no key) or openai
MODEL_PROVIDER=stub
# Only used when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAX_TOOL_STEPS=4
TOOL_TIMEOUT_MS=5000
RUN_TIMEOUT_MS=60000
