# Port the HTTP API binds. The frontend defaults to this value.
PORT=7271
HOST=0.0.0.0

# Which model provider drives the agent loop.
#   stub   - deterministic local rules, no network, no key (default)
#   openai - Mastra agent on an OpenAI model, needs OPENAI_API_KEY
MODEL_PROVIDER=stub

# Only read when MODEL_PROVIDER=openai. Without it the server logs a warning
# and falls back to the stub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hard ceiling on tool calls per question.
MAX_TOOL_STEPS=4

# Comma-separated allow-list, or * for any origin.
CORS_ORIGINS=*
